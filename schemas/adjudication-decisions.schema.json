{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterbussch/pageledger/schemas/adjudication-decisions.json",
  "title": "PageLedger Adjudication Decisions",
  "description": "<page_id>.decisions.json, an adjudicator's answers to one packet, read by `pageledger adjudicate JOB --decisions DIR --reviewer NAME`.",
  "type": "object",
  "required": ["page_id", "contested_sha256", "decisions"],
  "properties": {
    "page_id": { "type": "string", "minLength": 1 },
    "contested_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["span_id", "text", "confidence", "note"],
        "properties": {
          "span_id": { "type": "string", "pattern": "^sp_[0-9a-f]{16}$" },
          "text": { "type": "string", "description": "What the page prints between the span's before and after; misprints as printed." },
          "confidence": { "enum": ["high", "medium", "low"], "description": "Only high settles the span." },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
