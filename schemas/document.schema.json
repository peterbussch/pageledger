{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterbussch/pageledger/schemas/document.json",
  "title": "PageLedger Document Report",
  "description": "Authoritative document report; report.md and transcript.md derive from these fields. Selected text preserves raw UTF-8 bytes.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "report_format": {
      "enum": ["0.5.1", "0.6", "0.9"],
      "description": "0.5.1 uses the historical absolute source links; 0.6 uses paths relative to the job directory; 0.9 keeps the 0.6 paths, renders report.md for a reader (what happened and what to do first, the record last) and records hold_causes. Reports without this marker use the 0.5.0 renderer."
    },
    "limits_history": {
      "type": "array",
      "description": "Limits raised on resume after a budget pause, oldest first. Absent until a limit is raised.",
      "items": {
        "type": "object",
        "required": ["at", "limit", "previous", "value"],
        "properties": {
          "at": {"type": "string", "minLength": 1},
          "limit": {"enum": ["max_attempt_pages", "max_image_pages", "max_local_image_pages", "max_tokens", "max_cost_usd", "max_image_requests"]},
          "previous": {"type": "number"},
          "value": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "relocations": {
      "type": "array",
      "description": "Each change review-job or adjudicate made to the job in a directory other than the one it was written in, oldest first. Absent until such a change.",
      "items": {
        "type": "object",
        "required": ["root", "command", "at"],
        "properties": {
          "root": {"type": "string", "minLength": 1},
          "command": {"enum": ["review-job", "adjudicate"]},
          "at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "stage_accounting": {
      "type": "array",
      "description": "Configured stage attempt counts. A zero-page stage includes the recorded reason it did not run. Absent in older reports.",
      "items": {
        "type": "object",
        "properties": {
          "stage": {"enum": ["local_text", "local_ocr", "second_ocr", "local_image", "image", "second_opinion"]},
          "pages_read": {"type": "integer", "minimum": 0},
          "reason": {"type": ["string", "null"]}
        },
        "required": ["stage", "pages_read", "reason"],
        "additionalProperties": false
      }
    },
    "engines": {
      "type": "object",
      "description": "Since report format 0.9. The engine each configured stage ran, copied from the job's policy so that report.md can name each reading by what made it: the adapter, the Tesseract language of pdf_ocr, and the model a vision stage asked for (the model the endpoint served is in the attempt's image evidence). Absent in older reports.",
      "propertyNames": {"enum": ["local_text", "local_ocr", "second_ocr", "local_image", "image", "second_opinion"]},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {"type": "string", "minLength": 1},
          "lang": {"type": "string", "minLength": 1},
          "model": {"type": "string"}
        },
        "required": ["adapter"],
        "additionalProperties": false
      }
    },
    "hold_policy": {
      "enum": ["0.6", "0.6.1", "0.8", "0.9"],
      "description": "Warning-to-hold mapping the job used; 0.6.1 lets clean text from a later engine clear a blank candidate; 0.8 also holds a text layer two agreeing later readings outvote, and a reader with under half the literal OCR's words; 0.9 keeps an inherited OCR layer as a witness beside the job's own OCR, holds a literal reading that lost the pre-reform letters another kept, ranks readings that are all held by evidence, and raises no hold from an attempt that never finished. Absent on reports written before 0.6, whose jobs filed low_confidence under coverage_defect."
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "annotations": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "present",
                "none",
                "unknown"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "status",
            "count"
          ],
          "additionalProperties": false
        },
        "kind": {
          "const": "page_images"
        },
        "iiif": {
          "type": "object",
          "description": "Present when the folder is a snapshot fetch-iiif wrote: its fetch record when the source was read. Context, not identity: the source sha256 does not cover it.",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of iiif-fetch.json when the source was read."
            },
            "requested_url": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "complete",
                "incomplete"
              ]
            },
            "canvases": {
              "type": "array",
              "description": "One entry per page, in page order: the canvas each image came from.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "canvas_index": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "canvas_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "canvas_index",
                  "canvas_id"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "sha256",
            "requested_url",
            "status",
            "canvases"
          ],
          "additionalProperties": false
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "name",
              "sha256",
              "bytes",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "path",
        "sha256",
        "page_count",
        "annotations"
      ],
      "additionalProperties": false
    },
    "selected_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "processing",
        "completed",
        "halted",
        "paused_budget"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_image_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "enum": [
                    "local_text",
                    "local_ocr",
                    "second_ocr",
                    "local_image",
                    "image",
                    "second_opinion"
                  ]
                },
                "outcome": {
                  "enum": [
                    "completed",
                    "failed",
                    "outcome_unknown",
                    "response"
                  ]
                },
                "raw_artifact": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "raw_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "format": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "classification": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "alignment": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "usage": {
                  "type": "object"
                },
                "failure": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "run_path": {
                  "type": "string",
                  "minLength": 1
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "input_evidence": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "adapter_capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "layout_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "tiling": {"type": "object", "description": "A reading in tiles: its plan, the layout it was cut along, and what the tiles found. Present only in jobs with processing.tiling.", "properties": {"plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "layout_attempt": {"type": ["string", "null"]}, "tiles": {"type": "integer", "minimum": 1}, "sent": {"type": "integer", "minimum": 0}, "failed": {"type": "array", "items": {"type": "string", "pattern": "^t[0-9]{2}$"}}, "edge_cut": {"type": "array", "items": {"type": "string", "pattern": "^t[0-9]{2}$"}}}, "required": ["plan_sha256", "layout_attempt", "tiles", "sent", "failed", "edge_cut"], "additionalProperties": false}
              },
              "required": [
                "attempt_id",
                "stage",
                "outcome",
                "raw_artifact",
                "raw_sha256",
                "format",
                "warnings",
                "classification",
                "alignment",
                "usage",
                "failure"
              ],
              "additionalProperties": false
            }
          },
          "selected_attempt": {
            "type": [
              "string",
              "null"
            ]
          },
          "disposition": {
            "enum": [
              "unreviewed_text",
              "coverage_defect",
              "low_confidence",
              "numeric_column_conflict",
              "engine_disagreement",
              "numeric_disagreement",
              "unconfirmed_model_output",
              "contested",
              "adjudicated_text",
              "blank_candidate",
              "provider_failure",
              "outcome_unknown",
              "pending",
              "reviewed_text",
              "reviewed_blank",
              "illustration",
              "handwriting",
              "unreadable",
              "source_defect"
            ]
          },
          "review_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "schema_version": {
                    "const": "0.1"
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "decisions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "page_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "page_number": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "disposition": {
                          "enum": [
                            "reviewed_text",
                            "reviewed_blank",
                            "illustration",
                            "handwriting",
                            "unreadable",
                            "source_defect"
                          ]
                        },
                        "selected_attempt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "output_sha256": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reviewer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reviewed_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "correction": {
                          "description": "Present when a person corrected the page's text; see job-review.schema.json.",
                          "type": "object",
                          "properties": {
                            "artifact": {"type": "string", "pattern": "^corrections/[^/]+-[0-9a-f]{64}\\.txt$"},
                            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            "from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            "words": {
                              "type": "object",
                              "properties": {
                                "changed": {"type": "integer", "minimum": 0},
                                "added": {"type": "integer", "minimum": 0},
                                "removed": {"type": "integer", "minimum": 0}
                              },
                              "required": ["changed", "added", "removed"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["artifact", "sha256", "from_sha256", "words"],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "page_id",
                        "page_number",
                        "disposition",
                        "selected_attempt",
                        "output_sha256",
                        "reason",
                        "reviewer",
                        "reviewed_at"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "disposition": {
                                "const": "reviewed_text"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "selected_attempt": {
                                "type": "string",
                                "minLength": 1
                              },
                              "output_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "selected_attempt": {
                                "type": "null"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "output_sha256": {
                                "type": "null"
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "selected_attempt": {
                                "type": "string",
                                "minLength": 1
                              },
                              "output_sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "schema_version",
                  "source_sha256",
                  "decisions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "selected_output": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "attempt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "format": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "edition": {
                    "const": true,
                    "description": "Present when the text is the selected attempt's edition: its adjudicated changes applied."
                  },
                  "correction": {
                    "description": "Present when the text is a person's correction, recorded in the page's review receipt. path and sha256 then name the corrected text; from_path and from_sha256 the text it was made from (the attempt's output, its edition, or an earlier correction); words what it changed; reviewer, reviewed_at and reason come from the receipt that first recorded it, which a later accept does not replace.",
                    "type": "object",
                    "properties": {
                      "reviewer": {"type": "string", "minLength": 1},
                      "reviewed_at": {"type": "string", "minLength": 1},
                      "reason": {"type": "string", "minLength": 1},
                      "from_path": {"type": "string", "minLength": 1},
                      "from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "words": {
                        "type": "object",
                        "properties": {
                          "changed": {"type": "integer", "minimum": 0},
                          "added": {"type": "integer", "minimum": 0},
                          "removed": {"type": "integer", "minimum": 0}
                        },
                        "required": ["changed", "added", "removed"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["from_path", "from_sha256", "words", "reviewer", "reviewed_at", "reason"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "attempt_id",
                  "path",
                  "sha256",
                  "format",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "source_link": {
            "type": "string",
            "minLength": 1
          },
          "contested": {
            "type": "object",
            "description": "Where the selected reader's text differs from the best literal reading. The spans are in the artifact; the job keeps its hash and counts. Present only in jobs with processing.contest.",
            "properties": {
              "artifact": {"type": "string", "pattern": "^contested/doc_[0-9]{4}_page_[0-9]{4,}\\.json$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "base_attempt": {"type": "string", "minLength": 1},
              "witness_attempt": {"type": "string", "minLength": 1},
              "kinds": {
                "type": "object",
                "propertyNames": {"enum": ["homoglyph", "glyph", "misprint_guard", "word", "number", "region"]},
                "additionalProperties": {"type": "integer", "minimum": 1}
              },
              "open": {"type": "integer", "minimum": 0, "description": "Spans neither a rule nor a high-confidence adjudication settled."},
              "by_rule": {"type": "integer", "minimum": 0},
              "by_review": {"type": "integer", "minimum": 0, "description": "Spans settled by a high-confidence decision in an adjudication receipt."},
              "superseded": {
                "type": "array",
                "description": "Coverage, confidence and blank holds set aside: those of readings the page no longer rests on, and the witness's own once no span is open.",
                "items": {
                  "type": "object",
                  "properties": {"reason": {"enum": ["coverage_defect", "low_confidence", "blank_candidate"]}, "attempt": {"type": "string", "minLength": 1}},
                  "required": ["reason", "attempt"],
                  "additionalProperties": false
                }
              },
              "witness_projection": {"type": "object", "description": "The witness regrouped in the tile order of a reading in tiles (tiling.project_witness), kept as an artifact.", "properties": {"plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "string", "pattern": "^witnesses/doc_[0-9]{4}_page_[0-9]{4,}\\.txt$"}, "outside_items": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["plan_sha256", "artifact", "outside_items", "sha256"], "additionalProperties": false}
            },
            "required": ["artifact", "sha256", "base_attempt", "witness_attempt", "kinds", "open", "by_rule", "by_review", "superseded"],
            "additionalProperties": false
          },
          "edition": {
            "type": "object",
            "description": "The selected reading with its adjudicated changes applied, once no span is open. The attempt itself is never edited.",
            "properties": {
              "artifact": {"type": "string", "pattern": "^editions/doc_[0-9]{4}_page_[0-9]{4,}\\.txt$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "base_attempt": {"type": "string", "minLength": 1}
            },
            "required": ["artifact", "sha256", "base_attempt"],
            "additionalProperties": false
          },
          "adjudications": {
            "type": "array",
            "description": "Adjudication receipts (schema 0.2), oldest first. Each binds its decisions to the contested-spans artifact they answer; a receipt bound to an earlier artifact no longer applies.",
            "items": {
              "type": "object",
              "properties": {
                "schema_version": {"enum": ["0.2", "0.3"], "description": "0.3 since 0.9: a high answer that is neither reading settles nothing; 0.2 receipts keep their meaning."},
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "page_id": {"type": "string", "minLength": 1},
                "page_number": {"type": "integer", "minimum": 1},
                "contested_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "image_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "decisions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "span_id": {"type": "string", "pattern": "^sp_[0-9a-f]{16}$"},
                      "text": {"type": "string"},
                      "confidence": {"enum": ["high", "medium", "low"]},
                      "note": {"type": "string"}
                    },
                    "required": ["span_id", "text", "confidence", "note"],
                    "additionalProperties": false
                  }
                },
                "reviewer": {"type": "string", "minLength": 1},
                "reviewed_at": {"type": "string", "minLength": 1}
              },
              "required": ["schema_version", "source_sha256", "page_id", "page_number", "contested_sha256", "image_sha256", "decisions", "reviewer", "reviewed_at"],
              "additionalProperties": false
            }
          },
          "triggers": {
            "type": "array",
            "description": "Why a page climbed although its reading was not held, with the evidence that fired. Present only in jobs with escalate_on beyond hold.",
            "items": {
              "type": "object",
              "properties": {
                "trigger": {"enum": ["rough", "disagreement", "always", "ocr_layer", "uncorroborated"]},
                "attempt": {"type": "string", "minLength": 1}
              },
              "required": ["trigger", "attempt"]
            }
          },
          "comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "left_attempt": {
                  "type": "string",
                  "minLength": 1
                },
                "right_attempt": {
                  "type": "string",
                  "minLength": 1
                },
                "agreement_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "spans": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {"type": "object"}
                },
                "number_differences": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {"type": "object"}
                },
                "truncated": {"type": "boolean"}
              },
              "required": [
                "left_attempt",
                "right_attempt",
                "agreement_ratio",
                "spans",
                "number_differences",
                "truncated"
              ],
              "additionalProperties": false
            }
          },
          "hold_causes": {
            "type": "array",
            "description": "Report format 0.9: every hold on each of the page's readings and what caused it, as the job's hold policy derived them. Absent when no reading is held.",
            "items": {
              "type": "object",
              "properties": {
                "attempt_id": {"type": "string"},
                "hold": {"type": "string"},
                "cause": {
                  "type": "string",
                  "description": "The warning or classification code that files the hold; empty_reading (a reading with no text), alignment (the table check); or a hold the policy places itself: layer_outvoted, reader_short, letters_lost."
                },
                "yat_words": {"type": "integer", "minimum": 0},
                "most_yat_words": {"type": "integer", "minimum": 0}
              },
              "required": ["attempt_id", "hold", "cause"],
              "additionalProperties": false
            }
          },
          "review_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": "0.1"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "decisions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "page_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page_number": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "disposition": {
                        "enum": [
                          "reviewed_text",
                          "reviewed_blank",
                          "illustration",
                          "handwriting",
                          "unreadable",
                          "source_defect"
                        ]
                      },
                      "selected_attempt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "output_sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reviewer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reviewed_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "correction": {
                        "description": "Present when a person corrected the page's text; see job-review.schema.json.",
                        "type": "object",
                        "properties": {
                          "artifact": {"type": "string", "pattern": "^corrections/[^/]+-[0-9a-f]{64}\\.txt$"},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                          "from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                          "words": {
                            "type": "object",
                            "properties": {
                              "changed": {"type": "integer", "minimum": 0},
                              "added": {"type": "integer", "minimum": 0},
                              "removed": {"type": "integer", "minimum": 0}
                            },
                            "required": ["changed", "added", "removed"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["artifact", "sha256", "from_sha256", "words"],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "page_id",
                      "page_number",
                      "disposition",
                      "selected_attempt",
                      "output_sha256",
                      "reason",
                      "reviewer",
                      "reviewed_at"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "disposition": {
                              "const": "reviewed_text"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "selected_attempt": {
                              "type": "string",
                              "minLength": 1
                            },
                            "output_sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "selected_attempt": {
                              "type": "null"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "output_sha256": {
                              "type": "null"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "selected_attempt": {
                              "type": "string",
                              "minLength": 1
                            },
                            "output_sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "schema_version",
                "source_sha256",
                "decisions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page_id",
          "page_number",
          "source_sha256",
          "attempts",
          "selected_attempt",
          "disposition",
          "review_reasons",
          "review",
          "next_action",
          "selected_output",
          "source_link"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "attempt_pages": {
          "type": "integer",
          "minimum": 0
        },
        "image_calls": {
          "type": "integer",
          "minimum": 0
        },
        "image_requests": {"type": "integer", "minimum": 0, "description": "Image requests the paid stages sent: one per tile of a reading in tiles, one per other page. Present only in jobs with processing.tiling."},
        "local_image_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Calls to the local_image stage. Present only in jobs that configure one."
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_known": {
          "type": "boolean"
        },
        "known_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens_known": {
          "type": "boolean"
        },
        "paid_cost_known": {
          "type": "boolean"
        },
        "paid_tokens_known": {
          "type": "boolean"
        }
      },
      "required": [
        "attempt_pages",
        "image_calls",
        "tokens",
        "cost_usd",
        "cost_known"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object"
    },
    "links": {
      "type": "object",
      "properties": {
        "article": {
          "type": [
            "string",
            "null"
          ]
        },
        "custody": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "article",
        "custody"
      ],
      "additionalProperties": false
    },
    "source_retention": {
      "type": "object",
      "properties": {
        "capture": {
          "const": "present"
        },
        "preservation": {
          "const": "unverified"
        },
        "removal_eligibility": {
          "const": "not_assessed"
        },
        "removed": {
          "const": false
        }
      },
      "required": [
        "capture",
        "preservation",
        "removal_eligibility",
        "removed"
      ],
      "additionalProperties": false
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "properties": {
        "source_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "selected_pages": {
          "type": "integer",
          "minimum": 0
        },
        "processed_pages": {
          "type": "integer",
          "minimum": 0
        },
        "selected_outputs": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_pages": {
          "type": "integer",
          "minimum": 0
        },
        "adjudicated_pages": {
          "type": "integer",
          "minimum": 0,
          "description": "Pages whose every difference from the literal reading is settled, none of them read by a person. Counted apart from unresolved_pages, which keeps its 0.6 meaning. Present only in jobs with processing.contest."
        },
        "corrected_pages": {
          "type": "integer",
          "minimum": 1,
          "description": "Pages whose selected text is a person's correction. Present only when there is one."
        }
      },
      "required": [
        "source_pages",
        "selected_pages",
        "processed_pages",
        "selected_outputs",
        "unresolved_pages"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "properties": {
        "path": {
          "const": "transcript.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "created_at",
    "source",
    "selected_pages",
    "status",
    "pages",
    "usage",
    "limits",
    "links",
    "source_retention",
    "next_action",
    "counts",
    "transcript"
  ],
  "additionalProperties": false
}
