{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageLedger exact transmitted page image evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "page_image"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "artifact": {
      "type": "string",
      "pattern": "^evidence/(?!\\.{1,2}/)(?!.*\\/\\.{1,2}/)(?!.*//)[^\\\\\\u0000]+\\.[jJ][pP][eE]?[gG]$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "const": "image/jpeg"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3145728
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "color_space": {
      "const": "RGB"
    },
    "requested_model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "system_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "crop": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "full_page"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "box"
            },
            "units": {
              "const": "pdf_points"
            },
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "units",
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      ]
    },
    "renderer": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "command",
        "version",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "source_sha256",
    "page_number",
    "artifact",
    "sha256",
    "media_type",
    "bytes",
    "width",
    "height",
    "color_space",
    "requested_model",
    "model",
    "provider",
    "prompt_sha256",
    "crop",
    "renderer"
  ],
  "additionalProperties": false
}
