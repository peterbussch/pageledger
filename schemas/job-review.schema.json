{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterbussch/pageledger/schemas/job-review.json",
  "title": "PageLedger Job Review Receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "enum": [
              "reviewed_text",
              "reviewed_blank",
              "illustration",
              "handwriting",
              "unreadable",
              "source_defect"
            ]
          },
          "selected_attempt": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "correction": {
            "description": "Present when a person corrected the page's text. The corrected text is kept at artifact; from_sha256 is the hash of the text the correction started from: the output named by selected_attempt and output_sha256, or an earlier correction of the same page. words counts the whitespace-separated words it changed, added and removed. Only on reviewed_text.",
            "type": "object",
            "properties": {
              "artifact": {"type": "string", "pattern": "^corrections/[^/]+-[0-9a-f]{64}\\.txt$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "words": {
                "type": "object",
                "properties": {
                  "changed": {"type": "integer", "minimum": 0},
                  "added": {"type": "integer", "minimum": 0},
                  "removed": {"type": "integer", "minimum": 0}
                },
                "required": ["changed", "added", "removed"],
                "additionalProperties": false
              }
            },
            "required": ["artifact", "sha256", "from_sha256", "words"],
            "additionalProperties": false
          }
        },
        "required": [
          "page_id",
          "page_number",
          "disposition",
          "selected_attempt",
          "output_sha256",
          "reason",
          "reviewer",
          "reviewed_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "reviewed_text"
                }
              }
            },
            "then": {
              "properties": {
                "selected_attempt": {
                  "type": "string",
                  "minLength": 1
                },
                "output_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "selected_attempt": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "output_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "selected_attempt": {
                  "type": "string",
                  "minLength": 1
                },
                "output_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "decisions"
  ],
  "additionalProperties": false
}
