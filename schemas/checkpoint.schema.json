{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageLedger immutable recovery job",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_source_path": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "code_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profile": {
              "type": [
                "object",
                "null"
              ]
            },
            "metadata": {
              "type": "object",
              "properties": {
                "input_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "output_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "deterministic": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "input_types",
                "output_types",
                "capabilities",
                "deterministic"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "version",
            "code_sha256",
            "package_sha256",
            "profile",
            "metadata"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "page_count": {
                "type": "integer",
                "minimum": 1
              },
              "pages": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "page_count"
            ],
            "additionalProperties": false
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "page_count": {
                "type": "integer",
                "minimum": 1
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "page_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "confidence": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "page_id",
                    "page_number",
                    "type",
                    "confidence",
                    "action",
                    "reason"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "source",
              "source_sha256",
              "page_count",
              "pages"
            ],
            "additionalProperties": false
          }
        },
        "imported_routes": {
          "type": [
            "object",
            "null"
          ]
        },
        "route_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routing": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_run_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_path",
                "sha256",
                "source_run_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "log_level": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "skipped_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Hidden files (names starting with '.', such as .DS_Store and AppleDouble '._*' sidecars) found while expanding input directories and skipped. Present only when something was skipped."
        }
      },
      "required": [
        "run_id",
        "started_at",
        "root",
        "config_sha256",
        "config_source_path",
        "identity",
        "inputs",
        "documents",
        "imported_routes",
        "route_warnings",
        "routing",
        "log_level"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sha256",
    "payload"
  ],
  "additionalProperties": false
}
