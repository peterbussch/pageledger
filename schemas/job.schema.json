{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterbussch/pageledger/schemas/job.json",
  "title": "PageLedger Document Job Checkpoint",
  "description": "One source document, stable selected source pages, linked resumable child runs and durable processing policy.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "page_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "annotations": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "present",
                    "none",
                    "unknown"
                  ]
                },
                "count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "status",
                "count"
              ],
              "additionalProperties": false
            },
            "kind": {
              "const": "page_images"
            },
            "iiif": {
              "type": "object",
              "description": "Present when the folder is a snapshot fetch-iiif wrote: its fetch record when the source was read. Context, not identity: the source sha256 does not cover it.",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "SHA-256 of iiif-fetch.json when the source was read."
                },
                "requested_url": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "complete",
                    "incomplete"
                  ]
                },
                "canvases": {
                  "type": "array",
                  "description": "One entry per page, in page order: the canvas each image came from.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "canvas_index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "canvas_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "canvas_index",
                      "canvas_id"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sha256",
                "requested_url",
                "status",
                "canvases"
              ],
              "additionalProperties": false
            },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "name",
                  "sha256",
                  "bytes",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "path",
            "sha256",
            "page_count",
            "annotations"
          ],
          "additionalProperties": false
        },
        "selected_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "processing",
            "completed",
            "halted",
            "paused_budget"
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page_id": {
                "type": "string",
                "minLength": 1
              },
              "page_number": {
                "type": "integer",
                "minimum": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_image_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "stage": {
                      "enum": [
                        "local_text",
                        "local_ocr",
                        "second_ocr",
                        "local_image",
                        "image",
                        "second_opinion"
                      ]
                    },
                    "outcome": {
                      "enum": [
                        "completed",
                        "failed",
                        "outcome_unknown",
                        "response"
                      ]
                    },
                    "raw_artifact": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "raw_sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "format": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "classification": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "alignment": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "usage": {
                      "type": "object"
                    },
                    "failure": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "run_path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "input_evidence": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "adapter_capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "layout_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "tiling": {"type": "object", "description": "A reading in tiles: its plan, the layout it was cut along, and what the tiles found. Present only in jobs with processing.tiling.", "properties": {"plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "layout_attempt": {"type": ["string", "null"]}, "tiles": {"type": "integer", "minimum": 1}, "sent": {"type": "integer", "minimum": 0}, "failed": {"type": "array", "items": {"type": "string", "pattern": "^t[0-9]{2}$"}}, "edge_cut": {"type": "array", "items": {"type": "string", "pattern": "^t[0-9]{2}$"}}}, "required": ["plan_sha256", "layout_attempt", "tiles", "sent", "failed", "edge_cut"], "additionalProperties": false}
                  },
                  "required": [
                    "attempt_id",
                    "stage",
                    "outcome",
                    "raw_artifact",
                    "raw_sha256",
                    "format",
                    "warnings",
                    "classification",
                    "alignment",
                    "usage",
                    "failure"
                  ],
                  "additionalProperties": false
                }
              },
              "selected_attempt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "disposition": {
                "enum": [
                  "unreviewed_text",
                  "coverage_defect",
                  "low_confidence",
                  "numeric_column_conflict",
                  "engine_disagreement",
                  "numeric_disagreement",
                  "unconfirmed_model_output",
                  "contested",
                  "adjudicated_text",
                  "blank_candidate",
                  "provider_failure",
                  "outcome_unknown",
                  "pending",
                  "reviewed_text",
                  "reviewed_blank",
                  "illustration",
                  "handwriting",
                  "unreadable",
                  "source_defect"
                ]
              },
              "review_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "review": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "schema_version": {
                        "const": "0.1"
                      },
                      "source_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "decisions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "page_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "page_number": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "disposition": {
                              "enum": [
                                "reviewed_text",
                                "reviewed_blank",
                                "illustration",
                                "handwriting",
                                "unreadable",
                                "source_defect"
                              ]
                            },
                            "selected_attempt": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "output_sha256": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            },
                            "reviewer": {
                              "type": "string",
                              "minLength": 1
                            },
                            "reviewed_at": {
                              "type": "string",
                              "format": "date-time"
                            }
                          },
                          "required": [
                            "page_id",
                            "page_number",
                            "disposition",
                            "selected_attempt",
                            "output_sha256",
                            "reason",
                            "reviewer",
                            "reviewed_at"
                          ],
                          "additionalProperties": false,
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "disposition": {
                                    "const": "reviewed_text"
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "selected_attempt": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "output_sha256": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$"
                                  }
                                }
                              }
                            },
                            {
                              "if": {
                                "properties": {
                                  "selected_attempt": {
                                    "type": "null"
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "output_sha256": {
                                    "type": "null"
                                  }
                                }
                              },
                              "else": {
                                "properties": {
                                  "selected_attempt": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "output_sha256": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "schema_version",
                      "source_sha256",
                      "decisions"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              },
              "review_history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "const": "0.1"
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "decisions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "page_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "page_number": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "disposition": {
                            "enum": [
                              "reviewed_text",
                              "reviewed_blank",
                              "illustration",
                              "handwriting",
                              "unreadable",
                              "source_defect"
                            ]
                          },
                          "selected_attempt": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "output_sha256": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reviewer": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reviewed_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "page_id",
                          "page_number",
                          "disposition",
                          "selected_attempt",
                          "output_sha256",
                          "reason",
                          "reviewer",
                          "reviewed_at"
                        ],
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "disposition": {
                                  "const": "reviewed_text"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "selected_attempt": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "output_sha256": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "selected_attempt": {
                                  "type": "null"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "output_sha256": {
                                  "type": "null"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "selected_attempt": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "output_sha256": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "schema_version",
                    "source_sha256",
                    "decisions"
                  ],
                  "additionalProperties": false
                }
              },
              "contested": {
                "type": "object",
                "description": "Where the selected reader's text differs from the best literal reading. The spans are in the artifact; the job keeps its hash and counts. Present only in jobs with processing.contest.",
                "properties": {
                  "artifact": {"type": "string", "pattern": "^contested/doc_[0-9]{4}_page_[0-9]{4,}\\.json$"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "base_attempt": {"type": "string", "minLength": 1},
                  "witness_attempt": {"type": "string", "minLength": 1},
                  "kinds": {
                    "type": "object",
                    "propertyNames": {"enum": ["homoglyph", "glyph", "misprint_guard", "word", "number", "region"]},
                    "additionalProperties": {"type": "integer", "minimum": 1}
                  },
                  "open": {"type": "integer", "minimum": 0, "description": "Spans neither a rule nor a high-confidence adjudication settled."},
                  "by_rule": {"type": "integer", "minimum": 0},
                  "by_review": {"type": "integer", "minimum": 0, "description": "Spans settled by a high-confidence decision in an adjudication receipt."},
                  "superseded": {
                    "type": "array",
                    "description": "Coverage, confidence and blank holds set aside: those of readings the page no longer rests on, and the witness's own once no span is open.",
                    "items": {
                      "type": "object",
                      "properties": {"reason": {"enum": ["coverage_defect", "low_confidence", "blank_candidate"]}, "attempt": {"type": "string", "minLength": 1}},
                      "required": ["reason", "attempt"],
                      "additionalProperties": false
                    }
                  },
                  "witness_projection": {"type": "object", "description": "The witness regrouped in the tile order of a reading in tiles (tiling.project_witness), kept as an artifact.", "properties": {"plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "string", "pattern": "^witnesses/doc_[0-9]{4}_page_[0-9]{4,}\\.txt$"}, "outside_items": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "required": ["plan_sha256", "artifact", "outside_items", "sha256"], "additionalProperties": false}
                },
                "required": ["artifact", "sha256", "base_attempt", "witness_attempt", "kinds", "open", "by_rule", "by_review", "superseded"],
                "additionalProperties": false
              },
              "edition": {
                "type": "object",
                "description": "The selected reading with its adjudicated changes applied, once no span is open. The attempt itself is never edited.",
                "properties": {
                  "artifact": {"type": "string", "pattern": "^editions/doc_[0-9]{4}_page_[0-9]{4,}\\.txt$"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "base_attempt": {"type": "string", "minLength": 1}
                },
                "required": ["artifact", "sha256", "base_attempt"],
                "additionalProperties": false
              },
              "adjudications": {
                "type": "array",
                "description": "Adjudication receipts (schema 0.2), oldest first. Each binds its decisions to the contested-spans artifact they answer; a receipt bound to an earlier artifact no longer applies.",
                "items": {
                  "type": "object",
                  "properties": {
                    "schema_version": {"const": "0.2"},
                    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "page_id": {"type": "string", "minLength": 1},
                    "page_number": {"type": "integer", "minimum": 1},
                    "contested_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "image_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                    "decisions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "span_id": {"type": "string", "pattern": "^sp_[0-9a-f]{16}$"},
                          "text": {"type": "string"},
                          "confidence": {"enum": ["high", "medium", "low"]},
                          "note": {"type": "string"}
                        },
                        "required": ["span_id", "text", "confidence", "note"],
                        "additionalProperties": false
                      }
                    },
                    "reviewer": {"type": "string", "minLength": 1},
                    "reviewed_at": {"type": "string", "minLength": 1}
                  },
                  "required": ["schema_version", "source_sha256", "page_id", "page_number", "contested_sha256", "image_sha256", "decisions", "reviewer", "reviewed_at"],
                  "additionalProperties": false
                }
              },
              "triggers": {
                "type": "array",
                "description": "Why a page climbed although its reading was not held, with the evidence that fired. Present only in jobs with escalate_on beyond hold.",
                "items": {
                  "type": "object",
                  "properties": {
                    "trigger": {"enum": ["rough", "disagreement", "always", "ocr_layer", "uncorroborated"]},
                    "attempt": {"type": "string", "minLength": 1}
                  },
                  "required": ["trigger", "attempt"]
                }
              },
              "comparisons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "left_attempt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "right_attempt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "agreement_ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "spans": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object"
                      }
                    },
                    "number_differences": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object"
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "left_attempt",
                    "right_attempt",
                    "agreement_ratio",
                    "spans",
                    "number_differences",
                    "truncated"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "page_id",
              "page_number",
              "source_sha256",
              "attempts",
              "selected_attempt",
              "disposition",
              "review_reasons",
              "review",
              "next_action"
            ],
            "additionalProperties": false
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "attempt_pages": {
              "type": "integer",
              "minimum": 0
            },
            "image_calls": {
              "type": "integer",
              "minimum": 0
            },
            "image_requests": {"type": "integer", "minimum": 0, "description": "Image requests the paid stages sent: one per tile of a reading in tiles, one per other page. Present only in jobs with processing.tiling."},
            "local_image_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Calls to the local_image stage. Present only in jobs that configure one."
            },
            "tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cost_known": {
              "type": "boolean"
            },
            "known_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "tokens_known": {
              "type": "boolean"
            },
            "paid_cost_known": {
              "type": "boolean"
            },
            "paid_tokens_known": {
              "type": "boolean"
            }
          },
          "required": [
            "attempt_pages",
            "image_calls",
            "tokens",
            "cost_usd",
            "cost_known"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object"
        },
        "links": {
          "type": "object",
          "properties": {
            "article": {
              "type": [
                "string",
                "null"
              ]
            },
            "custody": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "article",
            "custody"
          ],
          "additionalProperties": false
        },
        "source_retention": {
          "type": "object",
          "properties": {
            "capture": {
              "const": "present"
            },
            "preservation": {
              "const": "unverified"
            },
            "removal_eligibility": {
              "const": "not_assessed"
            },
            "removed": {
              "const": false
            }
          },
          "required": [
            "capture",
            "preservation",
            "removal_eligibility",
            "removed"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy": {
          "type": "object"
        },
        "lexicon": {
          "description": "Identity of the lexicon the rough trigger and contest used. Present only when the job configures one.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {"type": "string"},
                "language": {"type": "string"},
                "version": {"type": "string"},
                "dictionary": {"type": "string"}
              },
              "required": ["provider", "language", "version", "dictionary"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "A plain word list: where the job read it, its hash and size, and how words are matched.",
              "properties": {
                "provider": {"const": "wordlist"},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer", "minimum": 1},
                "words": {"type": "integer", "minimum": 1},
                "match": {"const": "nfc-casefold"}
              },
              "required": ["provider", "path", "sha256", "bytes", "words", "match"],
              "additionalProperties": false
            }
          ]
        },
        "limits_history": {
          "type": "array",
          "description": "Limits raised on resume after a budget pause, oldest first. Absent until a limit is raised.",
          "items": {
            "type": "object",
            "required": ["at", "limit", "previous", "value"],
            "properties": {
              "at": {"type": "string", "minLength": 1},
              "limit": {"enum": ["max_attempt_pages", "max_image_pages", "max_local_image_pages", "max_tokens", "max_cost_usd", "max_image_requests"]},
              "previous": {"type": "number"},
              "value": {"type": "number"}
            },
            "additionalProperties": false
          }
        },
        "relocations": {
          "type": "array",
          "description": "Each change review-job or adjudicate made to the job in a directory other than root, the one it was written in, oldest first. Absent until such a change.",
          "items": {
            "type": "object",
            "required": ["root", "command", "at"],
            "properties": {
              "root": {"type": "string", "minLength": 1},
              "command": {"enum": ["review-job", "adjudicate"]},
              "at": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "hold_policy": {
          "enum": ["0.6", "0.6.1", "0.8"],
          "description": "Warning-to-hold mapping for this job; 0.6.1 lets clean text from a later engine clear a blank candidate; 0.8 also holds a text layer two agreeing later readings outvote, and a reader with under half the literal OCR's words. Absent on jobs written before 0.6, which filed low_confidence under coverage_defect."
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "halt_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stage_id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "enum": [
                  "local_text",
                  "local_ocr",
                  "second_ocr",
                  "local_image",
                  "image",
                  "second_opinion"
                ]
              },
              "pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "run_path": {
                "type": "string",
                "minLength": 1
              },
              "config_path": {
                "type": "string",
                "minLength": 1
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "planned",
                  "running",
                  "completed",
                  "halted"
                ]
              },
              "tiles": {"type": "object", "description": "The tile plan of a stage that reads its page in tiles; the plan itself is in the stage's configuration.", "properties": {"plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 1}, "layout_attempt": {"type": ["string", "null"]}}, "required": ["plan_sha256", "count", "layout_attempt"], "additionalProperties": false}
            },
            "required": [
              "stage_id",
              "stage",
              "pages",
              "run_path",
              "config_path",
              "config_sha256",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "created_at",
        "source",
        "selected_pages",
        "status",
        "pages",
        "usage",
        "limits",
        "links",
        "source_retention",
        "next_action",
        "root",
        "config",
        "config_sha256",
        "policy",
        "package_sha256",
        "halt_reason",
        "stages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sha256",
    "payload"
  ],
  "additionalProperties": false
}
