{
  "$id": "https://github.com/peterbussch/pageledger/schemas/review-sheet-binding.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Written beside a review sheet as <sheet>.binding.json. For each row it records the evidence the row was written from; importing the sheet refuses a row whose evidence has changed since.",
  "properties": {
    "bindings": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "minLength": 1,
            "type": "string"
          },
          "output_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The hash of the text the row was written for: the selected output, its edition, or, on a page a person corrected, the correction."
          },
          "page_id": {
            "minLength": 1,
            "type": "string"
          },
          "page_number": {
            "minimum": 1,
            "type": "integer"
          },
          "review_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Since 0.9. The SHA-256 of the page's review decision when the row was written (its JSON with sorted keys), or null when the page had none. A row with a decision is refused once the page has been reviewed again. Absent from bindings written before 0.9, whose rows are not checked for it."
          },
          "selected_attempt": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "source_sha256",
          "page_id",
          "page_number",
          "selected_attempt",
          "output_sha256"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^p[0-9]{4,}$"
      },
      "type": "object"
    },
    "schema_version": {
      "const": "0.1"
    }
  },
  "required": [
    "schema_version",
    "bindings"
  ],
  "title": "PageLedger Review Sheet Binding",
  "type": "object"
}
